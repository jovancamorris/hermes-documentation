{
  "info": {
    "_postman_id": "sa-hermes-collection-v21",
    "name": "Hermes Agent - System Analyst API (Port 8643)",
    "description": "Postman Collection resmi untuk EKSAD Hermes System Analyst Gateway (Port 8643) mendukung OpenAI API (/v1) dan Native Hermes Sessions API (/api/sessions) untuk TSD, Flyway DDL, dan RabbitMQ Schemas.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://203.145.34.37:8643",
      "type": "string",
      "description": "Base URL API Server Hermes System Analyst (Port 8643)"
    },
    {
      "key": "apiKey",
      "value": "10ff9bb178374d9e1d23d1c39abcd305d3566820151b2edfd72e939290e58fe9",
      "type": "string",
      "description": "API_SERVER_KEY (Bearer Token)"
    },
    {
      "key": "session_id",
      "value": "api_1785212211_12b5637c",
      "type": "string",
      "description": "Session ID unik untuk chat history"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{apiKey}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "OpenAI Compatible Endpoints (/v1)",
      "item": [
        {
          "name": "1. Health Check - List Models",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/models",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "models"]
            },
            "description": "Cek status kesehatan server dan daftar model aktif untuk profile System Analyst."
          }
        },
        {
          "name": "2. Chat Completion (Stateless)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"model\": \"system-analyst\",\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"Tolong buatkan outline TSD singkat untuk microservice svc-user-management dengan Quarkus Reactive dan RabbitMQ sesuai standar EKSAD.\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/chat/completions",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "chat", "completions"]
            },
            "description": "Mengirimkan pesan obrolan sekali respon (stateless) tanpa menyimpan riwayat di database server."
          }
        }
      ]
    },
    {
      "name": "Native Hermes Sessions API (/api/sessions)",
      "item": [
        {
          "name": "1. Create New Session",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Session Jovan - TSD User Management Service\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/sessions",
              "host": ["{{baseUrl}}"],
              "path": ["api", "sessions"]
            },
            "description": "Starter chat yang mana nanti akan disimpan di SQLite server (hermes own). Mengembalikan session_id dari chat tersebut."
          }
        },
        {
          "name": "2. Send Chat to Session (Stateful)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"Tolong buatkan DDL Flyway SQL untuk tabel user_account dan user_role sesuai standar EKSAD (termasuk auto audit trail).\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/sessions/{{session_id}}/chat",
              "host": ["{{baseUrl}}"],
              "path": ["api", "sessions", "{{session_id}}", "chat"]
            },
            "description": "Mengirim obrolan lanjutan ke sesi tertentu. Percakapan tersimpan otomatis di database server."
          }
        },
        {
          "name": "3. Get Session Messages History",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/sessions/{{session_id}}/messages",
              "host": ["{{baseUrl}}"],
              "path": ["api", "sessions", "{{session_id}}", "messages"]
            },
            "description": "Mengambil seluruh daftar riwayat obrolan (Chat History) yang tersimpan pada session_id bersangkutan."
          }
        },
        {
          "name": "4. Delete Session",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/sessions/{{session_id}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "sessions", "{{session_id}}"]
            },
            "description": "Menghapus sesi tertentu dari database server."
          }
        }
      ]
    }
  ]
}
