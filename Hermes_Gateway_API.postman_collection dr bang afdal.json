    {
      "name": "5. Asynchronous Agent Runs",
      "item": [
        {
          "name": "Start Run",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "X-Hermes-Session-Key",
                "value": "tenant-001:user-001:run",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{HERMES_BASE_URL}}/v1/runs",
              "host": [
                "{{HERMES_BASE_URL}}"
              ],
              "path": [
                "v1",
                "runs"
              ]
            },
            "description": "Start an agent run and immediately return a run_id (HTTP 202 Accepted).\n\nExample response:\n```json\n{\n  \"run_id\": \"run_1234567890abcdef\",\n  \"status\": \"started\"\n}\n```\n\nAccepts `conversation_history` as an array of {role, content} objects. If both `conversation_history` and `previous_response_id` are supplied, explicit `conversation_history` wins.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"model\": \"system-analyst\",\n  \"session_id\": \"async-analysis-001\",\n  \"instructions\": \"Jawab dalam Bahasa Indonesia.\",\n  \"input\": \"Analisis requirement ini dan hasilkan daftar risiko teknis.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Poll Run",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{HERMES_BASE_URL}}/v1/runs/{{run_id}}",
              "host": [
                "{{HERMES_BASE_URL}}"
              ],
              "path": [
                "v1",
                "runs",
                "{{run_id}}"
              ]
            },
            "description": "Poll run status.\n\nTypical statuses: queued, running, waiting_for_approval, completed, failed, stopping, cancelled."
          }
        },
        {
          "name": "Stream Run Events",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{HERMES_BASE_URL}}/v1/runs/{{run_id}}/events",
              "host": [
                "{{HERMES_BASE_URL}}"
              ],
              "path": [
                "v1",
                "runs",
                "{{run_id}}",
                "events"
              ]
            },
            "description": "Stream run lifecycle and tool events via SSE.\n\nTypical events: message.delta, approval.request, approval.responded, run.completed, run.failed, run.cancelled. Tool-progress events may also be emitted by the active agent."
          }
        },
        {
          "name": "Resolve Approval",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{HERMES_BASE_URL}}/v1/runs/{{run_id}}/approval",
              "host": [
                "{{HERMES_BASE_URL}}"
              ],
              "path": [
                "v1",
                "runs",
                "{{run_id}}",
                "approval"
              ]
            },
            "description": "Resolve a pending dangerous-command approval. Allowed choices: once, session, always, deny. Aliases approve, approved, and allow map to once.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"choice\": \"once\",\n  \"resolve_all\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Stop Run",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{HERMES_BASE_URL}}/v1/runs/{{run_id}}/stop",
              "host": [
                "{{HERMES_BASE_URL}}"
              ],
              "path": [
                "v1",
                "runs",
                "{{run_id}}",
                "stop"
              ]
            },
            "description": "Interrupt an active run."
          }
        }
      ],
      "description": "/v1/runs \u2014 start long-running agent turns without blocking the HTTP request, poll status, stream lifecycle events, resolve approvals, and stop runs."
    },
    {
      "name": "6. Cron Jobs",
      "item": [
        {
          "name": "List Jobs",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{HERMES_BASE_URL}}/api/jobs?include_disabled=true",
              "host": [
                "{{HERMES_BASE_URL}}"
              ],
              "path": [
                "api",
                "jobs"
              ],
              "query": [
                {
                  "key": "include_disabled",
                  "value": "true"
                }
              ]
            },
            "description": "List cron jobs.\n\nNote: routes are installed and operational, but the stable /v1/capabilities payload currently reports jobs_admin: false. Treat these routes as operational/version-sensitive rather than a permanent public compatibility contract."
          }
        },
        {
          "name": "Create Job",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{HERMES_BASE_URL}}/api/jobs",
              "host": [
                "{{HERMES_BASE_URL}}"
              ],
              "path": [
                "api",
                "jobs"
              ]
            },
            "description": "Create cron job. Required fields: name, schedule. Max name length 200 chars; max prompt length 5,000 chars.\n\nSupported schedule examples:\n30m\nevery 2h\n0 9 * * *\n2026-08-01T09:00:00+07:00",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Daily architecture reminder\",\n  \"schedule\": \"0 9 * * *\",\n  \"prompt\": \"Buat pengingat untuk meninjau technical design yang masih terbuka.\",\n  \"deliver\": \"local\",\n  \"skills\": [\n    \"eksad-tsd-design\"\n  ],\n  \"repeat\": 30\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Get Job",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
