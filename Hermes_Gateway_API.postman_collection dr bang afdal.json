              "host": [
                "{{HERMES_BASE_URL}}"
              ],
              "path": [
                "api",
                "jobs",
                "{{job_id}}"
              ]
            },
            "description": "Get one cron job. Job IDs must match 12 lowercase hexadecimal characters."
          }
        },
        {
          "name": "Update Job",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{HERMES_BASE_URL}}/api/jobs/{{job_id}}",
              "host": [
                "{{HERMES_BASE_URL}}"
              ],
              "path": [
                "api",
                "jobs",
                "{{job_id}}"
              ]
            },
            "description": "Update cron job. Allowed fields: name, schedule, prompt, deliver, skills, skill, repeat, enabled.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"schedule\": \"0 10 * * *\",\n  \"enabled\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Pause Job",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{HERMES_BASE_URL}}/api/jobs/{{job_id}}/pause",
              "host": [
                "{{HERMES_BASE_URL}}"
              ],
              "path": [
                "api",
                "jobs",
                "{{job_id}}",
                "pause"
              ]
            },
            "description": "Pause cron job."
          }
        },
        {
          "name": "Resume Job",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{HERMES_BASE_URL}}/api/jobs/{{job_id}}/resume",
              "host": [
                "{{HERMES_BASE_URL}}"
              ],
              "path": [
                "api",
                "jobs",
                "{{job_id}}",
                "resume"
              ]
            },
            "description": "Resume cron job."
          }
        },
        {
          "name": "Trigger Job Now",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{HERMES_BASE_URL}}/api/jobs/{{job_id}}/run",
              "host": [
                "{{HERMES_BASE_URL}}"
              ],
              "path": [
                "api",
                "jobs",
                "{{job_id}}",
                "run"
              ]
            },
            "description": "Trigger immediate execution."
          }
        },
        {
          "name": "Delete Job",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{HERMES_BASE_URL}}/api/jobs/{{job_id}}",
              "host": [
                "{{HERMES_BASE_URL}}"
              ],
              "path": [
                "api",
                "jobs",
                "{{job_id}}"
              ]
            },
            "description": "Delete cron job."
          }
        }
      ],
      "description": "/api/jobs \u2014 schedule, manage, pause/resume, and manually trigger cron-based agent jobs. Operational but version-sensitive (jobs_admin capability flag is currently false)."
    }
