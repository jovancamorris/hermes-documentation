              "raw": "{\n  \"model\": \"{{model}}\",\n  \"messages\": [\n    {\"role\": \"system\", \"content\": \"Anda adalah EKSAD Business Analyst Agentic AI.\"},\n    {\"role\": \"user\", \"content\": \"Jelaskan 3 standar utama penyusunan Kriteria Penerimaan User Story metode Given-When-Then di EKSAD.\"}\n  ]\n}"
