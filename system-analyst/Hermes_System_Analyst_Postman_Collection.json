{
  "info": {
    "_postman_id": "sa-hermes-collection-v22",
    "name": "Hermes Agent - System Analyst API (Port 8643)",
    "description": "Postman Collection resmi EKSAD Hermes System Analyst Gateway (Port 8643). Mendukung OpenAI API (/v1) dan Native Hermes Sessions API (/api/sessions) dengan auto-capture session_id, user_context, persistent SQLite storage, serta token accounting.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://203.145.34.37:8643",
      "type": "string",
      "description": "Base URL API Server Hermes System Analyst (Port 8643)"
    },
    {
      "key": "apiKey",
      "value": "10ff9bb178374d9e1d23d1c39abcd305d3566820151b2edfd72e939290e58fe9",
      "type": "string",
      "description": "API_SERVER_KEY (Bearer Token Auth)"
    },
    {
      "key": "session_id",
      "value": "api_1785212211_12b5637c",
      "type": "string",
      "description": "Session ID unik (otomatis ter-update saat eksekusi Create Session)"
    },
    {
      "key": "model",
      "value": "system-analyst",
      "type": "string",
      "description": "Model Profile aktif untuk System Analyst (MiniMax-M2)"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{apiKey}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "OpenAI Compatible Endpoints (/v1)",
      "item": [
        {
          "name": "1. Health Check - List Models",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/models",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "models"]
            },
            "description": "Cek status kesehatan server gateway SA (Port 8643) dan verifikasi model profile system-analyst aktif."
          }
        },
        {
          "name": "2. Chat Completion (Stateless)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"model\": \"{{model}}\",\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"Tolong buatkan outline TSD singkat untuk microservice svc-user-management dengan Quarkus Reactive dan RabbitMQ sesuai standar EKSAD.\"\n    }\n  ],\n  \"user_context\": {\n    \"user_id\": \"USR-10293\",\n    \"role\": \"System Analyst\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/chat/completions",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "chat", "completions"]
            },
            "description": "Mengirimkan instruksi obrolan sekali respon (stateless) tanpa menyimpan riwayat di database server."
          }
        }
      ]
    },
    {
      "name": "Native Hermes Sessions API (/api/sessions)",
      "item": [
        {
          "name": "1. Create New Session",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "    var jsonData = pm.response.json();",
                  "    if (jsonData.session_id) {",
                  "        pm.collectionVariables.set('session_id', jsonData.session_id);",
                  "        console.log('Auto-set session_id to: ' + jsonData.session_id);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Session Jovan - TSD User Management Service Design\",\n  \"model\": \"{{model}}\",\n  \"user_context\": {\n    \"user_id\": \"USR-10293\",\n    \"username\": \"jovan_sa\",\n    \"role\": \"System Analyst\",\n    \"department\": \"IT Development\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/sessions",
              "host": ["{{baseUrl}}"],
              "path": ["api", "sessions"]
            },
            "description": "Inisialisasi sesi perancangan TSD/proyek baru di SQLite server Hermes. Mengembalikan session_id unik dan secara otomatis menyimpan session_id tersebut ke variabel collection."
          }
        },
        {
          "name": "2. Send Chat to Session (Stateful)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"Tolong buatkan DDL Flyway SQL untuk tabel user_account dan user_role sesuai standar EKSAD (termasuk 7 audit columns wajib & soft delete).\",\n  \"user_context\": {\n    \"user_id\": \"USR-10293\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/sessions/{{session_id}}/chat",
              "host": ["{{baseUrl}}"],
              "path": ["api", "sessions", "{{session_id}}", "chat"]
            },
            "description": "Mengirim obrolan lanjutan ke sesi aktif. Server Hermes otomatis memuat histori obrolan sebelumnya dari database dan menambahkan pesan baru ke histori."
          }
        },
        {
          "name": "3. Get Session Messages History & Usage",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/sessions/{{session_id}}/messages",
              "host": ["{{baseUrl}}"],
              "path": ["api", "sessions", "{{session_id}}", "messages"]
            },
            "description": "Mengambil seluruh daftar riwayat obrolan (Chat History) dan akumulasi pemakaian token (accumulated_usage) yang tersimpan pada session_id bersangkutan."
          }
        },
        {
          "name": "4. Get All Active Sessions List",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/sessions",
              "host": ["{{baseUrl}}"],
              "path": ["api", "sessions"]
            },
            "description": "Memanggil daftar seluruh sesi percakapan yang tersimpan di server database Hermes."
          }
        },
        {
          "name": "5. Delete Session",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/sessions/{{session_id}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "sessions", "{{session_id}}"]
            },
            "description": "Menghapus sesi perancangan TSD tertentu dari database server."
          }
        }
      ]
    }
  ]
}
