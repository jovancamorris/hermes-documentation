              "raw": "{\n  \"model\": \"system-analyst\",\n  \"instructions\": \"Jawab dalam Bahasa Indonesia.\",\n  \"input\": \"Identifikasi komponen utama untuk service approval workflow.\",\n  \"stream\": false\n}",
              "options": {
