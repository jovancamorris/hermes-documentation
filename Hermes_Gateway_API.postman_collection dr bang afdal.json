              "raw": "{\n  \"message\": [\n    {\n      \"type\": \"text\",\n      \"text\": \"Bandingkan diagram arsitektur saat ini dengan rancangan target.\"\n    },\n    {\n      \"type\": \"image_url\",\n      \"image_url\": {\n        \"url\": \"https://storage.example.com/tenant-001/current-architecture.png\",\n        \"detail\": \"high\"\n      }\n    },\n    {\n      \"type\": \"image_url\",\n      \"image_url\": {\n        \"url\": \"https://storage.example.com/tenant-001/target-architecture.png\",\n        \"detail\": \"high\"\n      }\n    }\n  ]\n}",
