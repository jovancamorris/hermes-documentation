        {
          "name": "Session Chat - Text + Images + Extracted DOCX Text (Recommended Multi-Artifact Pattern)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{HERMES_BASE_URL}}/api/sessions/{{session_id}}/chat",
              "host": [
                "{{HERMES_BASE_URL}}"
              ],
              "path": [
                "api",
                "sessions",
                "{{session_id}}",
                "chat"
              ]
            },
            "description": "Hermes has NO native file upload / Files API and rejects `input_file`/`file_id` content (HTTP 400 `unsupported_content_type`). This is the recommended production pattern: the application extracts DOCX/PDF text itself and sends it as plain text alongside image_url parts, since Hermes only officially accepts text and images inline.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": [\n    {\n      \"type\": \"text\",\n      \"text\": \"Analisis seluruh artefak berikut sebagai satu requirement package.\\n\\nDOCX metadata:\\n- file_id: file-docx-001\\n- tenant_id: tenant-001\\n- file_name: Procurement_BRD.docx\\n- mime_type: application/vnd.openxmlformats-officedocument.wordprocessingml.document\\n\\nDOCX extracted content:\\n--- BEGIN DOCUMENT ---\\n1. Business objective: Digital procurement approval.\\n2. Actors: Requester, Approver, Procurement Admin.\\n3. Requirement: Multi-level approval based on transaction amount.\\n--- END DOCUMENT ---\\n\\nBandingkan isi dokumen dengan dua diagram terlampir, lalu buat gap analysis.\"\n    },\n    {\n      \"type\": \"image_url\",\n      \"image_url\": {\n        \"url\": \"https://storage.example.com/tenant-001/process-current.png\",\n        \"detail\": \"high\"\n      }\n    },\n    {\n      \"type\": \"image_url\",\n      \"image_url\": {\n        \"url\": \"https://storage.example.com/tenant-001/process-target.png\",\n        \"detail\": \"high\"\n      }\n    }\n  ],\n  \"instructions\": \"Gunakan Bahasa Indonesia dan pisahkan temuan menjadi functional gap, data gap, integration gap, dan security gap.\",\n  \"model\": \"system-analyst\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
