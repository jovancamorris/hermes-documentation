{
  "info": {
    "_postman_id": "hermes-image-upload-vision-v1",
    "name": "Hermes Agent & Backend - Image Upload & Vision API Collection",
    "description": "Postman Collection resmi untuk pengujian Kirim / Upload Gambar ke Backend & Hermes Agent Server. Menyediakan 3 metode utama: (1) Base64 Data URI di JSON Body, (2) Public Image URL Link di JSON Body, dan (3) Multipart / Form-Data Upload File Fisik (PNG/JPG).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://203.145.34.37:8643",
      "type": "string",
      "description": "Base URL Gateway Server (Port 8643 SA / Port 8642 BA)"
    },
    {
      "key": "apiKey",
      "value": "10ff9bb178374d9e1d23d1c39abcd305d3566820151b2edfd72e939290e58fe9",
      "type": "string",
      "description": "API_SERVER_KEY (Bearer Token Auth)"
    },
    {
      "key": "session_id",
      "value": "api_test_image_session_001",
      "type": "string",
      "description": "Session ID aktif"
    },
    {
      "key": "model",
      "value": "gpt-4o",
      "type": "string",
      "description": "Model Profile Multimodal Vision (gpt-4o / claude-3-5-sonnet)"
    },
    {
      "key": "user_id",
      "value": "USR-TEST-IMG-001",
      "type": "string",
      "description": "ID Pengguna Penguji"
    }
  ],
  "item": [
    {
      "name": "\ud83d\uddbc\ufe0f 1. Method 1: Base64 Data URI in JSON Body (Stateful Chat)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{apiKey}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"message\": \"Tolong analisis diagram wireframe/arsitektur pada gambar berikut:\",\n  \"image_url\": \"data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mP8z8BQDwAEhQGAhKmMIQAAAABJRU5ErkJggg==\",\n  \"user_id\": \"{{user_id}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/sessions/{{session_id}}/chat",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "sessions",
            "{{session_id}}",
            "chat"
          ]
        }
      }
    },
    {
      "name": "\ud83c\udf10 2. Method 2: Public Image URL Link in JSON Body (OpenAI Vision Standard)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{apiKey}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"model\": \"{{model}}\",\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": [\n        {\n          \"type\": \"text\",\n          \"text\": \"Analisis diagram arsitektur microservices dari URL gambar ini dan sebutkan komponen utamanya:\"\n        },\n        {\n          \"type\": \"image_url\",\n          \"image_url\": {\n            \"url\": \"https://raw.githubusercontent.com/Ikaf19/eksad-agentic-knowledge/main/docs/architecture-diagram.png\"\n          }\n        }\n      ]\n    }\n  ]\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/v1/chat/completions",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "chat",
            "completions"
          ]
        }
      }
    },
    {
      "name": "\ud83d\udcc1 3. Method 3: Multipart / Form-Data Physical File Upload (Backend Endpoint)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{apiKey}}",
            "type": "text"
          }
        ],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "file",
              "type": "file",
              "src": [],
              "description": "Pilih file gambar (.png / .jpg) dari komputer Anda di Postman"
            },
            {
              "key": "description",
              "type": "text",
              "value": "Diagram Wireframe Frontend Procurement Request",
              "description": "Deskripsi atau metadata gambar"
            },
            {
              "key": "user_id",
              "type": "text",
              "value": "{{user_id}}",
              "description": "ID Pengguna"
            }
          ]
        },
        "url": {
          "raw": "{{baseUrl}}/api/upload",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "upload"
          ]
        }
      }
    }
  ]
}