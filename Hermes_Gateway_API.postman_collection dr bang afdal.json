              "raw": "{\n  \"message\": [\n    {\n      \"type\": \"text\",\n      \"text\": \"Analisis diagram berikut.\"\n    },\n    {\n      \"type\": \"image_url\",\n      \"image_url\": {\n        \"url\": \"data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAA...\",\n        \"detail\": \"high\"\n      }\n    }\n  ]\n}",
